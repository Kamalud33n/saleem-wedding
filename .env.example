# Copy to .env.local and fill in your values.
# Never commit .env.local to git.

# Resend API key — https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxx

# Where RSVP and guestbook memory emails are delivered
RSVP_TO_EMAIL=you@example.com

# Sender shown in the inbox (must be a verified domain in Resend for production).
# For testing, Resend allows onboarding@resend.dev → your account email only.
# Used for both RSVP and guestbook notifications.
RSVP_FROM_EMAIL=Wedding RSVP <onboarding@resend.dev>

# Guestbook + analytics persistence — connect Blob store on Vercel.
# BLOB_READ_WRITE_TOKEN for local dev; BLOB_STORE_ID via OIDC on Vercel production.
# Local dev: guestbook uses data/guestbook.json unless BLOB_READ_WRITE_TOKEN is set.

# Private password for /manage — guestbook admin + analytics dashboard.
GUESTBOOK_ADMIN_PASSWORD=your-secure-password
